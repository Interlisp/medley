         (printout STREAM "%%!PS-Adobe-2.0" T %# (CL:WHEN BBOX
                                                     (PRINTOUT STREAM "%%%%BoundingBox: "
                                                            (CL:FLOOR (CAR BBOX)
                                                                   \PS.SCALE0)
                                                            " "
                                                            (CL:FLOOR (CADR BBOX)
                                                                   \PS.SCALE0)
                                                            " "
                                                            (CL:CEILING (CADDR BBOX)
                                                                   \PS.SCALE0)
                                                            " "
