                                             ((ILESSP CCODE FCHAR)
                                              (SETQ FCHAR CCODE)))
                                          (COND
                                             ((IGREATERP CCODE LCHAR)
                                              (SETQ LCHAR CCODE)))
                                          (SETA W CCODE CWIDTH]
                          (repeatuntil (EQ (CHARCODE EOL)
                                           (READCCODE IFILE)) do)))
               (SETQ FIRSTCHAR FCHAR)
               (SETQ LASTCHAR LCHAR))
         (CLOSEF IFILE)
