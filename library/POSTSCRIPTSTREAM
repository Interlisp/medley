                                  do (READCCODE IFILE))
               (repeatwhile (STRING-EQUAL "" (SETQ TOKEN (RSTRING IFILE))) do (READCCODE IFILE))
               [COND
                  ((NOT (AND (BOUNDP 'WeightMenu)
                             (type? MENU WeightMenu)))
                   (SETQ WeightMenu (create MENU
                                           ITEMS ← WeightMenuItems
