(\TEDIT.QUANTIZE
  [LAMBDA (VALUE QUANT UNIT ORIG)                            (* ; "Edited 25-Oct-2026 12:47 by rmk")
                                                             (* ; "Edited 15-Jun-2026 12:53 by rmk")

    (* ;; "If ORIG, value is in original (unscaled) units corresponding to a quantized scaled unit")

    (LET [(SCALED (TIMES QUANT (ROUND (FQUOTIENT VALUE UNIT)
