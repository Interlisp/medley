    (for PC OBJ STATEFN HEADINGS VALS inpieces (NEXTPIECE HEADINGSPC)
       when [AND (SETQ OBJ (POBJ PC))
                 (SETQ STATEFN (IMAGEOBJPROP OBJ 'STATEFN]
       do (SETQ PC (APPLY* STATEFN PC OBJ MENUTEXTOBJ))
