                                                            (* ; "Edited 12-Jun-90 18:59 by mitani")

    (* ;; "Given a set of margins and a unit, show the margin bar properly.  Negative values are unset, but indicate where to put the scale")

    (* ;; "MARGINSCALEOFFSET (constant 4) is the distance from th3e left edge of the scale box to the zero tick mark and 0 left margin of the scale")

    (* ;; "STREAM is an image stream, likely a display stream ")

    (* ;; "L1, LN, R are in the coordinate system of the paralooks, not the display positions in the object's coordinate system")

    (* ;; "")

    (* ;; "Round input points to the points corresonding to the nearest half UNIT.")

    (* ;; "Labels map points to units for printing, *WIDTH are widths of the label strings plus 1-point margin, *EDGE are the edge positions in points in the object's coordinate system (left-offset from the bounding box)")

    (DSPFONT (FONTCREATE 'TERMINAL 10)
           STREAM)                                           (* (IPLUS MARGINSCALEOFFSET
                                                             (\TEDIT.QUANTIZE (IDIFFERENCE
                                                             (PANERIGHT STREAM) 
                                                             \TEDIT.LINEREGION.WIDTH) 0.5 UNIT T)))
    (LET* [(OLDOP (DSPOPERATION 'ERASE STREAM))
           (UNIT (fetch (MARGINBAR MARUNIT) of MARGINBAR))
           (L1 (\TEDIT.QUANTIZE (fetch (MARGINBAR MARL1) of MARGINBAR)
                      0.5 UNIT T))
           (LN (\TEDIT.QUANTIZE (fetch (MARGINBAR MARLN) of MARGINBAR)
                      0.5 UNIT T))
           (R (\TEDIT.QUANTIZE (fetch (MARGINBAR MARR) of MARGINBAR)
                     0.5 UNIT T))
           (RIGHTLIM (fetch (MARGINBAR MARRLIM) of MARGINBAR))
           (L1LABEL (MDESCALE L1 UNIT))
           (LNLABEL (MDESCALE LN UNIT))
           (RLABEL (CL:IF (fetch (MARGINBAR RFLOAT) of MARGINBAR)
                       "Float"
                       (MDESCALE R UNIT)))
           (L1WIDTH (IPLUS 3 (STRINGWIDTH L1LABEL STREAM)))
           (LNWIDTH (IPLUS 3 (STRINGWIDTH LNLABEL STREAM)))
           (RWIDTH (IPLUS 3 (STRINGWIDTH RLABEL STREAM)))
           (L1EDGE (IPLUS MARGINSCALEOFFSET L1))
           (LNEDGE (IPLUS MARGINSCALEOFFSET LN))
           (EXTENDWIDTH (BITMAPWIDTH TEDIT.EXTENDEDRIGHTMARK))
           (REDGE (if (fetch (MARGINBAR RFLOAT) of MARGINBAR)
                      then RIGHTLIM
                    elseif (ILEQ R RIGHTLIM)
                      then (IPLUS MARGINSCALEOFFSET R)
                    else (IDIFFERENCE RIGHTLIM EXTENDWIDTH]

          (* ;; "Clear the margin region to white: 1 for the left border")

          (BLTSHADE WHITESHADE STREAM 1 LNBOTTOM MAX.SMALLP BARHEIGHT 'REPLACE)
          (BLTSHADE BLACKSHADE STREAM L1EDGE L1BOTTOM (ADD1 (IDIFFERENCE REDGE L1EDGE))
                 L1HEIGHT
                 'REPLACE)                                   (* ; "Put black in the L1 and LN bars")
          (BLTSHADE BLACKSHADE STREAM LNEDGE LNBOTTOM (ADD1 (IDIFFERENCE REDGE LNEDGE))
                 LNHEIGHT
                 'REPLACE)
          (DSPOPERATION 'INVERT STREAM)                      (* ; "For printing the numbers")

          (* ;; "L1")

          (CL:WHEN (fetch (MARGINBAR L1NEUTRAL) of MARGINBAR)
              (BLTSHADE EDITGRAY STREAM (ADD1 L1EDGE)
                     (ADD1 L1BOTTOM)
                     NEUTRALWIDTH
                     (IDIFFERENCE L1HEIGHT 2)
                     'REPLACE))
          (MOVETO (IPLUS 2 NEUTRALWIDTH L1EDGE)
                 (IPLUS L1BOTTOM 3)
                 STREAM)
          (PRIN3 L1LABEL STREAM)

          (* ;; "L2")

          (CL:WHEN (fetch (MARGINBAR LNNEUTRAL) of MARGINBAR)
              (BLTSHADE EDITGRAY STREAM (ADD1 LNEDGE)
                     (ADD1 LNBOTTOM)
                     NEUTRALWIDTH
                     (IDIFFERENCE LNHEIGHT 2)
                     'REPLACE))
          (MOVETO (IPLUS 2 NEUTRALWIDTH LNEDGE)
                 (IPLUS LNBOTTOM 3)
                 STREAM)
          (PRIN3 LNLABEL STREAM)

          (* ;; "Right margin")

          (CL:UNLESS (OR (fetch (MARGINBAR RFLOAT) of MARGINBAR)
                         (ILEQ R RIGHTLIM))                  (* ; 
                       "A non-visible right margin is marked by two wavy lines indicating a break.  ")
              (SETQ REDGE (IDIFFERENCE RIGHTLIM EXTENDWIDTH))
              (BITBLT TEDIT.EXTENDEDRIGHTMARK 0 0 STREAM REDGE LNBOTTOM (OR MAX.SMALLP EXTENDWIDTH)
                     BARHEIGHT
                     'INPUT
                     'REPLACE))

          (* ;; "Use the wavy-line width as the neutral gray")

          (CL:WHEN (fetch (MARGINBAR RNEUTRAL) of MARGINBAR)
              (BLTSHADE EDITGRAY STREAM (IDIFFERENCE REDGE EXTENDWIDTH)
                     (ADD1 LNBOTTOM)
                     EXTENDWIDTH
                     (IDIFFERENCE BARHEIGHT 2)
                     'REPLACE))
          (MOVETO (IDIFFERENCE REDGE (IPLUS RWIDTH EXTENDWIDTH))
                 (IPLUS LNBOTTOM 10)
                 STREAM)
          (PRIN3 RLABEL STREAM)

          (* ;; "")

          (DRAWMARGINSCALE STREAM UNIT)
          [if (fetch (MARGINBAR TABNEUTRAL) of MARGINBAR)
              then                                           (* ; 
                           "All tabs have been neutralized.  Just lay down a grey pattern over them.")
                   (MB.MARGINBAR.TABSHADE STREAM EDITGRAY)
            else (MB.MARGINBAR.TABSHADE STREAM WHITESHADE)
                 (for TAB in (fetch (MARGINBAR MARTABS) of MARGINBAR)
                    do                                       (* ; 
                                                     "Run thru the tabs, putting them down in place.")
                       (MB.MARGINBAR.SHOWTAB STREAM TAB 'PAINT]
          (DSPOPERATION OLDOP STREAM])

