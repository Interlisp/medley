                                             :WITH C4LIMIT = (- NCHARS 4)
                                             :COLLECT
                                             (+ (ASH (CHAR-HEX-VALUE (CHAR LINE I))
                                                     12)
                                                (ASH (CHAR-HEX-VALUE (CHAR LINE (+ 1 I)))
                                                     8)
                                                (ASH (CHAR-HEX-VALUE (AND (<= I C3LIMIT)
                                                                          (CHAR LINE (+ 2 I))))
                                                     4)
                                                (CHAR-HEX-VALUE (AND (<= I C4LIMIT)
                                                                     (CHAR LINE (+ 3 I))))))))
