                                                     (- (CHAR-CODE C)
                                                        (IL:CONSTANT (- (CHAR-CODE #\a)
                                                                        10))))
                                                    (T 0))
                                                 0))
                                      (PARSE-WORDS
                                       NIL
                                       (LOOP :FOR I :FROM 0 :TO (1- NCHARS)
