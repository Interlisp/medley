                                                       (IMAGEOBJPROP OBJ 'VERSION (CAR (CADR I)))
                                                       (IMAGEOBJPROP OBJ 'FILE (CADR (CADR I)))
                                                       (IMAGEOBJPROP OBJ 'TYPE TYPE))
                                                   OBJ))
                  BROWSER
           else '(No changes found])

