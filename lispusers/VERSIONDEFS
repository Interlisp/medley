(FIND.CHANGES
  [LAMBDA (NAME FILES TYPES)                                 (* ; "Edited 26-Oct-2026 00:47 by rmk")
                                                             (* ; "Edited 22-Oct-2026 22:49 by rmk")
                                                             (* ; "Edited  2-Aug-2025 21:36 by rmk")
                                                             (* ; "Edited 10-May-2025 20:46 by rmk")

    (* ;; "Returns the versions of FILES that contain changes to NAME  Return is in FILEDIR order.")

    (CL:UNLESS FILES
        (SETQ FILES (WHEREIS NAME TYPES T)))
    (CL:UNLESS TYPES
        (SETQ TYPES '(FNS FUNCTIONS)))
    (if FILES
        then [for F FILES1 FTYPE inside FILES
                collect [SETQ FILES1 (FILDIR (PACKFILENAME 'VERSION NIL 'BODY
                                                    (FINDFILE (PACKFILENAME 'BODY F 'EXTENSION ""]
                      [SETQ FTYPE (CAR (TYPESOF NAME TYPES NIL (CAR FILES1] 
                                                             (* ; 
                                                             "Should reduce (FNS FUNCTIONS) to FNS")
                      (for F1 CHANGES PREVDEF DEF DATE POS1 POS2 in FILES1 as V from -1 by -1
                         eachtime (SETQ DEF (GETDEF NAME FTYPE F1 'NOERROR)) when DEF
                         unless (EQUAL DEF PREVDEF)
                         collect (SETQ PREVDEF DEF)
                               (if (AND (EQMEMB 'FNS TYPES)
                                        (EDITDATE? (SETQ DATE (CADDR DEF)))
                                        (EQ '* (CAR DATE))
                                        (EQ '; (CADR DATE))
                                        (SETQ POS1 (STRPOS "Edited " (SETQ DATE (CADDR DATE))
                                                          1 NIL NIL T))
                                        (SETQ POS2 (STRPOS " by " DATE POS1)))
                                   then (SETQ DATE (SUBSTRING DATE POS1 (SUB1 POS2)))
                                 else (SETQ DATE (FILEDATE F1)))
                               (LIST V F1 DATE) finally (RETURN (CONS (LIST NAME FTYPE F)
                                                                      $$VAL]
      else (PRINTOUT T NAME " not found on " FILES T])

(VBROWSER
  [LAMBDA (NAME FILES TYPE)                                  (* ; "Edited 26-Oct-2026 00:47 by rmk")
                                                             (* ; "Edited 22-Oct-2026 21:40 by rmk")

    (* ;; "Version Browser")

    (LET ([FOUND (FIND.CHANGES NAME FILES (OR TYPE '(FNS FUNCTIONS]
          (VNCHARS 0)
          (FNCHARS 0)
          (DNCHARS 0)
          DATA BROWSER WIDTH HEIGHT)
         (if FOUND
             then                                            (* ; 
                                                             "File is a list, changes are indented")
                  [for F in FOUND join [SETQ VNCHARS (IMAX VNCHARS (for I in (CDR F)
                                                                      largest (NCHARS (CAR I))
                                                                      finally (RETURN $$EXTREME]
                                       [SETQ FNCHARS (IMAX FNCHARS (for I in (CDR F)
                                                                      largest (NCHARS (CADR I))
                                                                      finally (RETURN $$EXTREME]
                                       (SETQ DNCHARS (IMAX DNCHARS (for I in (CDR F)
                                                                      largest (NCHARS (CADDR I))
                                                                      finally (RETURN $$EXTREME]
                  [SETQ DATA
                   (for F in FOUND
                      join (CONS (CONS (SUBSTRING (CONCAT (CAR F))
                                              2 -2))
                                 (for I STREAM in (CDR F)
                                    collect (SETQ STREAM (CL:MAKE-STRING-OUTPUT-STREAM))
                                          (PRINTOUT STREAM .FR (IPLUS 3 VNCHARS)
                                                 (CAR I)
                                                 -2
                                                 (CADR I)
                                                 -2 .FR (IPLUS 3 VNCHARS 2 FNCHARS 2 DNCHARS)
                                                 (CADDR I))
                                          (LIST (CL:GET-OUTPUT-STREAM-STRING STREAM)
                                                I]
                  (SETQ WIDTH (IPLUS (STRINGWIDTH "  " DEFAULTFONT)
                                     (STRINGWIDTH (CAADR DATA)
                                            DEFAULTFONT)))   (* ; "Title height?")
                  [SETQ HEIGHT (IPLUS (FONTPROP WindowTitleDisplayStream 'HEIGHT)
                                      (IMIN 500 (ITIMES (ADD1 (LENGTH DATA))
                                                       (FONTPROP DEFAULTFONT 'HEIGHT]
                  (SETQ BROWSER (OBJ.CREATEW 'VERTICAL (GETBOXREGION WIDTH HEIGHT)
                                       (CONCAT "Versions of " NAME " as " (OR TYPE "function"))
                                       NIL NIL 0))
                  (OBJ.ADDMANYTOW BROWSER (for I OBJ in DATA
                                             collect (SETQ OBJ (create IMAGEOBJ
                                                                      OBJECTDATUM ← (CAR I)
                                                                      IMAGEOBJFNS ← VBROWSER.IMAGEFNS
                                                                      ))
                                                   (CL:WHEN (CADR I)
